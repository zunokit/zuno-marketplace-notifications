export const dynamic = 'force-dynamic'

export default async function ApiKeysPage() {
  const apiKeys = await prisma.apiKey.findMany({
    orderBy: { createdAt: 'desc' },
    include: {
      organization: {
        select: {
          name: true,
        },
      },
    },
