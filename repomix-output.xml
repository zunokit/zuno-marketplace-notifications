        channel: body.channel,
        type: body.type,
        enabled: body.enabled,
        frequency: body.frequency || 'REALTIME',
        quietHoursStart: body.quietHoursStart,
        quietHoursEnd: body.quietHoursEnd,
        timezone: body.timezone,
