  // Group preferences by user
  const userPrefs = preferences.reduce(
    (acc, pref) => {
      const userId = pref.userId
      if (!acc[userId]) {
        acc[userId] = {
          user: pref.user,
          channels: {},
          frequency: pref.frequency,
          timezone: pref.timezone,
        }
      }
      acc[userId].channels[pref.channel] = pref.enabled
      return acc
    },
    {} as Record<
