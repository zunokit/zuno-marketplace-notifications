{
  "name": "zuno-marketplace-notifications",
  "version": "1.0.0",
  "description": "Enterprise-grade multi-channel notification service for Zuno NFT Marketplace",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config tests/setup/jest.config.js --passWithNoTests",
    "test:watch": "jest --config tests/setup/jest.config.js --watch",
    "test:ci": "jest --config tests/setup/jest.config.js --ci --coverage --passWithNoTests",
    "db:generate": "prisma generate --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:seed": "tsx src/infrastructure/database/prisma/seed.ts",
    "db:studio": "prisma studio --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=src/infrastructure/database/prisma/schema.prisma",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "email:dev": "email dev --dir src/components/emails --port 3001"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.3.0",
    "better-fetch": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "handlebars": "^4.7.8",
    "lucide-react": "^0.553.0",
    "nanoid": "^5.0.9",
    "next": "16.0.10",
    "nodemailer": "^7.0.10",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-email": "^4.3.2",
    "redis": "^4.7.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "winston": "^3.18.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@react-email/preview-server": "^4.3.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.19.0"
}
